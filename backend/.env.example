# Exact browser origins, without paths or trailing slashes. Uvicorn does not load
# this file automatically; export the variable before starting the API.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://maiamcs.github.io
CORS_ALLOW_CREDENTIALS=false
# Optional absolute path to the canonical forecast fixtures when deployed separately.
# FORECAST_DEMO_DATA_DIR=/path/to/LogisticsCase1/contracts/fixtures/forecast
# The versioned real geographic layers served at /api/v1/geography/layers/{id}.
# GEOGRAPHY_DATA_DIR=/path/to/LogisticsCase1/contracts/geography
# Optional: absolute path to the supplied trained CBM (defaults to backend/models/catboost_congestion.cbm).
# Install requirements-model.lock before enabling inference. No training is run.
# CATBOOST_MODEL_PATH=C:/Projects/LogisticsCase1/backend/models/catboost_congestion.cbm
