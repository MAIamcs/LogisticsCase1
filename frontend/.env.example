# Values are embedded at BUILD time, including in GitHub Pages builds.
VITE_DATA_MODE=demo
# The trained CatBoost view requires api mode and a running separate backend.
# Required only in api mode; omit the /api/v1 suffix.
VITE_API_BASE_URL=http://127.0.0.1:8000
# Override for GitHub project Pages. Defaults to / for local development.
VITE_BASE_PATH=/
